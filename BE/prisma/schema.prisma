generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  foods      foods[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model food_meal_times {
  food_id   String @db.Uuid
  meal_time String @db.VarChar(30)
  foods     foods  @relation(fields: [food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([food_id, meal_time])
}

model foods {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id              String?                 @db.Uuid
  category_id           String?                 @db.Uuid
  name                  String                  @db.VarChar(150)
  image_url             String
  image_public_id       String?
  description           String?
  spicy                 Boolean                 @default(false)
  vegetarian            Boolean                 @default(false)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  food_meal_times       food_meal_times[]
  categories            categories?             @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  users                 users?                  @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spin_history          spin_history[]
  user_food_preferences user_food_preferences[]

  @@index([category_id], map: "idx_foods_category")
  @@index([name], map: "idx_foods_name")
  @@index([owner_id], map: "idx_foods_owner")
}

model spin_history {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  food_id            String?  @db.Uuid
  food_name          String   @db.VarChar(150)
  food_image_url     String
  food_category_name String?  @db.VarChar(100)
  filters            Json?
  spun_at            DateTime @default(now()) @db.Timestamptz(6)
  foods              foods?   @relation(fields: [food_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([spun_at(sort: Desc)], map: "idx_spin_history_date")
  @@index([food_id], map: "idx_spin_history_food")
  @@index([user_id], map: "idx_spin_history_user")
}

model user_food_preferences {
  user_id     String   @db.Uuid
  food_id     String   @db.Uuid
  is_enabled  Boolean  @default(true)
  is_favorite Boolean  @default(false)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  foods       foods    @relation(fields: [food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, food_id])
  @@index([food_id], map: "idx_preferences_food")
  @@index([user_id], map: "idx_preferences_user")
}

model users {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                  @unique @db.VarChar(255)
  password_hash         String
  display_name          String?                 @db.VarChar(100)
  avatar_url            String?
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  foods                 foods[]
  spin_history          spin_history[]
  user_food_preferences user_food_preferences[]
}
